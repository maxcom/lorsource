<?xml version='1.0' encoding='utf-8'?>

<Server port="-1" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <Service name="Catalina">
   <Executor name="tomcatThreadPool" namePrefix="tomcat-"
        maxThreads="256" minSpareThreads="32" maxQueueSize="256"/>

    <Connector port="8080" scheme="http" SSLEnabled="false" secure="false" address="127.0.0.1"
               protocol="org.apache.coyote.http11.Http11NioProtocol"
               connectionTimeout="20000" executor="tomcatThreadPool"
               compression="off" proxyPort="80"
               maxPartCount="200"
               redirectPort="8443"/>

    <Connector port="8444" proxyPort="443" address="127.0.0.1"
               protocol="org.apache.coyote.http11.Http11NioProtocol"
               scheme="https" secure="true" executor="tomcatThreadPool"
               compression="off"
               maxPartCount="200"/>

    <Engine name="Catalina" defaultHost="localhost">
        <Valve
            className="org.apache.catalina.valves.RemoteIpValve"
            protocolHeader="X-Forwarded-Proto"
            protocolHeaderHttpsValue="https"
            internalProxies="127\.0\.0\.1|185\.94\.108\..*"/>

      <Host name="localhost"  appBase="webapps"
            unpackWARs="true" autoDeploy="true">
      </Host>
    </Engine>
  </Service>
</Server>
