<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="2026073001" author="Maxim Valyanskiy">
    <addColumn tableName="email_domains_block">
      <column name="auto" type="boolean" valueBoolean="false">
        <constraints nullable="false"/>
      </column>
      <column name="moderator_id" type="int">
        <constraints nullable="true"/>
      </column>
      <column name="blocked_at" type="timestamptz" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
      </column>
    </addColumn>
  </changeSet>

  <changeSet id="2026073002" author="Maxim Valyanskiy">
    <addForeignKeyConstraint constraintName="email_domains_block_moderator_fkey"
                             baseTableName="email_domains_block" baseColumnNames="moderator_id"
                             referencedTableName="users" referencedColumnNames="id"
                             onDelete="SET NULL"/>
  </changeSet>

  <!-- Backfill: домены со сроком блокировки больше 7 дней от текущего момента
       считаем добавленными вручную, остальные — автоматическими. -->
  <changeSet id="2026073003" author="Maxim Valyanskiy">
    <sql>
      update email_domains_block
      set auto = (block_until &lt;= CURRENT_TIMESTAMP + interval '7 days'),
          blocked_at = block_until
    </sql>
  </changeSet>

  <changeSet id="2026073005" author="Maxim Valyanskiy">
    <sql>
      grant select, insert, update, delete on email_domains_block to linuxweb;
    </sql>
  </changeSet>
</databaseChangeLog>