#!/bin/sh

SERVICE=tomcat-opt.service

set -e

./mvnw -T 1C -P production clean package

echo Copying files...

if ! cmp -s deploy/tomcat-opt.service /usr/lib/systemd/system/tomcat-opt.service; then
    echo Installing systemd unit...
    sudo cp deploy/tomcat-opt.service /usr/lib/systemd/system/tomcat-opt.service
    sudo systemctl daemon-reload
fi

if ! cmp -s deploy/nginx.conf /etc/nginx/nginx.conf; then
    echo Installing nginx config...
    sudo cp deploy/nginx.conf /etc/nginx/nginx.conf.new
    sudo nginx -t -c /etc/nginx/nginx.conf.new
    sudo mv /etc/nginx/nginx.conf.new /etc/nginx/nginx.conf
    sudo systemctl reload nginx
fi

sudo systemctl stop $SERVICE
./mvnw -P production liquibase:update
sudo rm -rf /var/cache/tomcat/work/Catalina/localhost/ROOT/
sudo rsync --exclude WEB-INF/config.properties --delete-after -t -r -v target/lor-1.0-SNAPSHOT/ /var/lib/tomcat/webapps/ROOT
sudo touch /var/lib/tomcat/webapps/ROOT/WEB-INF/web.xml

sudo cp deploy/server.xml /opt/tomcat/conf/server.xml
sudo cp deploy/tomcat.conf /opt/tomcat/tomcat.conf

sudo systemctl start $SERVICE

echo done

